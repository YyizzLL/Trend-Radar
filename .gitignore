# ---- 环境 / 依赖 ----
.venv/
.env
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
*.tmp

# ---- 编辑器 ----
.idea/
.vscode/
*.swp

# ---- 浏览器调试配置（含登录 cookie 与浏览历史，绝不能入库）----
.edge-cdp/
.edge-cdp*/

# ---- 词库 ----
# 词库随仓库提供（138 个主体），用户按需增删 —— 它同时是「这个工具只做这个方向」的边界
# 只忽略本地备份（build_keywords.py 重写前手动留的 .bak）
CoreAssets/keywords.bak.json

# ---- 运行时数据：真实采集、状态、每日产出 ----
memory/
sandbox/
*.log

data/input/*
data/daily/*
data/state/*
# 保留目录骨架，让 clone 下来结构完整
!data/**/.gitkeep

# ---- 系统垃圾 ----
.DS_Store
Thumbs.db
